<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_void_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header Info Live Price -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XAUUSD LIVE (M15)"
                    android:textColor="@color/brand_sky_blue"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_running_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---.--"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="26sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Mode Price BID / ASK -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_mode_bid"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="BID"
                    android:textSize="10sp"
                    android:backgroundTint="@color/brand_sky_blue"
                    android:textColor="@color/bg_void_dark" />

                <Button
                    android:id="@+id/btn_mode_ask"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="ASK"
                    android:textSize="10sp"
                    android:backgroundTint="@color/surface_slate_800"
                    android:textColor="@color/text_secondary"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Chart Container WebView -->
        <WebView
            android:id="@+id/webview_chart"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="10dp"
            android:background="@color/surface_slate_900" />

        <!-- Decision Box Arbiter -->
        <LinearLayout
            android:id="@+id/box_decision_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/surface_slate_900"
            android:padding="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KEPUTUSAN MASTER ARBITER:"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_arbiter_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STANDBY"
                android:textColor="@color/macro_amber_gold"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_arbiter_confidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confidence: --%"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:id="@+id/layout_targets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tv_target_sl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SL: --"
                    android:textColor="@color/signal_sell_red"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_target_tp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TP: --"
                    android:textColor="@color/signal_buy_green"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
