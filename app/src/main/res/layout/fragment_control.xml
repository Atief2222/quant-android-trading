<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_void_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PUSAT KONTROL BOT & KOMITE AI"
            android:textColor="@color/brand_sky_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Tombol Audit AI Live -->
        <Button
            android:id="@+id/btn_trigger_scan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⚡ PICU AUDIT AI LIVE"
            android:backgroundTint="@color/macro_amber_gold"
            android:textColor="@color/bg_void_dark"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <!-- Panel Debat Multi-Agent -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_slate_900"
            android:padding="10dp"
            android:orientation="vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 Alpha Hunter (Peluang):"
                android:textColor="@color/brand_sky_blue"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_alpha_thesis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tekan picu audit untuk menganalisis konfluensi."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ Risk Officer (Uji Risiko):"
                android:textColor="@color/signal_sell_red"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tv_risk_rebuttal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menunggu data evaluasi risiko pasar."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Tombol Emergency Close -->
        <Button
            android:id="@+id/btn_emergency_close"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="🚨 EMERGENCY CLOSE ALL POSITIONS"
            android:backgroundTint="@color/signal_sell_red"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
